# ============================================================
# AutoMedic 环境变量示例
# 复制为 .env 后按需修改；docker compose 会自动读取
# 所有 AUTOMEDIC_ 前缀变量均会覆盖 config.yaml 中对应字段
# ============================================================

# 管理 API 令牌（前端登录处填写，请求头 X-Admin-Token）
AUTOMEDIC_ADMIN_TOKEN=change-me

# 敏感字段加密主密钥，至少 32 字节
# 生成：openssl rand -base64 32
# 留空更安全：容器首次启动会在数据卷生成随机密钥并长期复用（/app/data/.secret_key）
AUTOMEDIC_SECRET_KEY=

# 数据库：sqlite（默认）或 mysql
AUTOMEDIC_DB_DRIVER=sqlite
AUTOMEDIC_DB_DSN=/app/data/automedic.db
# AUTOMEDIC_DB_DRIVER=mysql
# AUTOMEDIC_DB_DSN=automedic:automedic@tcp(mysql:3306)/automedic?charset=utf8mb4&parseTime=True&loc=Local
