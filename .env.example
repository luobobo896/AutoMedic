# ============================================================
# AutoMedic 环境变量示例
# 复制为 .env 后按需修改；docker compose 会自动读取
# 注意：docker-compose.yml 只注入下面出现的变量（外加少量固定值），
#       其余 config.yaml 字段在容器路径下只能用 configs/config.docker.yaml 覆盖，
#       裸机部署则由 systemd 的 EnvironmentFile 读取整份 .env。
# 生成随机值：openssl rand -hex 24
# ============================================================

# 首次登录口令（引导管理员 admin 的初始密码）。release 模式必填，留空时 compose 直接报错。
AUTOMEDIC_AUTH_BOOTSTRAP_PASSWORD=

# PostgreSQL 口令（必填，留空时 compose 直接报错）。数据库仅支持 PostgreSQL。
AUTOMEDIC_DB_PASSWORD=

# 敏感字段加密主密钥，至少 32 字节
# 生成：openssl rand -base64 32
# 留空更安全：容器首次启动会在数据卷生成随机密钥并长期复用（/app/data/.secret_key）
AUTOMEDIC_SECRET_KEY=

# JWT 签名密钥（账号密码登录的令牌签名）。留空则回退使用 AUTOMEDIC_SECRET_KEY；
# 生产建议显式设置与 SECRET_KEY 不同的随机串（openssl rand -base64 32）。
AUTOMEDIC_JWT_SECRET=

# 可信反向代理网关节点 IP（逗号分隔）。空值=不信任任何代理，ClientIP 取 TCP 对端；
# 经 Nginx 等反代部署时填网关 IP，后端据此正确解析 X-Forwarded-For 取真实客户端 IP。
AUTOMEDIC_TRUSTED_PROXIES=

# 镜像与 dsh 版本固定（生产可复现性）：docker compose build 前 export
# AUTOMEDIC_IMAGE_TAG=1.2.3
# DSH_VERSION=0.1.2-rc.1
