# ============================================================
# AutoMedic 环境变量示例
# 复制为 .env 后按需修改；docker compose 会自动读取
# 所有 AUTOMEDIC_ 前缀变量均会覆盖 config.yaml 中对应字段
# ============================================================

# 管理 API 令牌（遗留开关；Web 已改为账号密码登录）
AUTOMEDIC_ADMIN_TOKEN=change-me

# 敏感字段加密主密钥，至少 32 字节
# 生成：openssl rand -base64 32
# 留空更安全：容器首次启动会在数据卷生成随机密钥并长期复用（/app/data/.secret_key）
AUTOMEDIC_SECRET_KEY=

# JWT 签名密钥（账号密码登录的令牌签名）。留空则回退使用 AUTOMEDIC_SECRET_KEY；
# 生产建议显式设置与 SECRET_KEY 不同的随机串（openssl rand -hex 32）。
AUTOMEDIC_JWT_SECRET=

# 可信反向代理网关节点 IP（逗号分隔）。空值=不信任任何代理，ClientIP 取 TCP 对端；
# 经 Nginx 等反代部署时填网关 IP，后端据此正确解析 X-Forwarded-For 取真实客户端 IP。
AUTOMEDIC_TRUSTED_PROXIES=

# 镜像与 dsh 版本固定（生产可复现性）：docker compose build 前 export
# AUTOMEDIC_IMAGE_TAG=1.2.3
# DSH_VERSION=0.1.2-rc.1

# 数据库：仅 PostgreSQL
AUTOMEDIC_DB_DRIVER=postgres
AUTOMEDIC_DB_PASSWORD=automedic
AUTOMEDIC_DB_DSN=host=postgres user=automedic password=automedic dbname=automedic port=5432 sslmode=disable TimeZone=Asia/Shanghai
